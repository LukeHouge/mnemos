{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/setup-agent-env.sh 2>&1 | tail -5; echo '---'; cd backend && uv run python scripts/lint_structure.py 2>&1; echo '---'; uv run --extra dev ruff check app/ 2>&1 | tail -5; echo '---'; uv run pytest tests/unit/ --tb=no -q 2>&1 | tail -5"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(just harness)",
      "Bash(just harness-local)",
      "Bash(just test)",
      "Bash(just test-*)",
      "Bash(just check)",
      "Bash(just check-local)",
      "Bash(just format)",
      "Bash(just format-local)",
      "Bash(just lint*)",
      "Bash(just typecheck)",
      "Bash(just lint-structure)",
      "Bash(bash scripts/setup-agent-env.sh)",
      "Bash(cd backend && *)"
    ]
  }
}
